# ─────────────────────────────────────────────────────────────────────────────
# KESPAY — environment configuration
# Copy to `.env` (repo root) and adjust. Never commit real secrets.
# DEMO MODE — NO REAL MONEY. This build cannot be configured to move real funds.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse-proxy hops to trust for client IPs (0 when running directly).
TRUST_PROXY=0

# --- Branding ----------------------------------------------------------------
# Optional display-name override. Full brand config lives in shared/src/brand.ts.
APP_NAME=KESPAY

# --- Demo safety -------------------------------------------------------------
# Must be "true". The server refuses to boot otherwise.
DEMO_MODE=true

# --- Client / CORS -----------------------------------------------------------
# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:5173

# --- Database ----------------------------------------------------------------
POSTGRES_USER=kespay
POSTGRES_PASSWORD=kespay_dev_password
POSTGRES_DB=kespay
DATABASE_URL=postgresql://kespay:kespay_dev_password@localhost:5432/kespay?schema=public
# Maximum connections in the API connection pool.
DATABASE_POOL_MAX=10
# Separate database used by the backend test-suite (docker compose --profile test).
# The suite refuses any database whose name does not contain "test".
TEST_DATABASE_URL=postgresql://kespay:kespay_dev_password@localhost:5433/kespay_test?schema=public

# --- Authentication ----------------------------------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
# Access-token lifetime (e.g. 15m, 1h).
JWT_EXPIRES_IN=15m
# Refresh-token (session) lifetime in days.
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when served over HTTPS (forced on in production).
COOKIE_SECURE=false

# --- Client (Vite) -----------------------------------------------------------
# API base used by the browser. "/api" works with the Vite dev proxy and nginx.
VITE_API_URL=/api
# Where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:4000
